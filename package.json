{
  "name": "discord-bot",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "start:watch": "bun --watch src/main.ts",
    "test": "bun test",
    "typecheck": "bun check",
    "lint": "bunx --bun --no-install oxlint --deny-warnings",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "build": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/main.ts --outfile bot"
  },
  "dependencies": {
    "discord.js": "14.25.1",
    "jimp": "1.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "oxlint": "1.88.0"
  }
}
